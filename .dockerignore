# Deny by default, including arbitrary custom native asset layouts.
# Vendor and browser caches are separate explicit named contexts.
**
!Dockerfile
!.dockerignore
!Cargo.toml
!Cargo.lock
!rust-toolchain
!.cargo/config.toml
!.github/scripts/fetch-dependencies.sh
!src/**/*.rs
!migration/Cargo.toml
!migration/src/**/*.rs
