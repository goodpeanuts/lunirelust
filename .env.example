# PostgreSQL is the lightweight default; optional: meili-keyword or meili-hybrid.
SEARCH_BACKEND=postgres
# Persistent local development. `just dev` copies this file to .env once.
APP_ENV=dev

POSTGRES_USER=luna_dev
POSTGRES_PASSWORD=luna_dev
POSTGRES_DB=luna_dev
DATABASE_URL=postgres://luna_dev:luna_dev@127.0.0.1:5434/luna_dev
DATABASE_MAX_CONNECTIONS=5
DATABASE_MIN_CONNECTIONS=1

MEILI_MASTER_KEY=luna_dev_master_key
MEILI_URL=http://127.0.0.1:7700

SERVICE_HOST=127.0.0.1
SERVICE_PORT=8012
RUST_LOG=info,sqlx=warn,sea_orm=warn,tower_http=info
JWT_SECRET_KEY=local-development-key-change-me

ASSETS_PUBLIC_PATH=.local/dev/assets/public
ASSETS_PUBLIC_URL=/assets/public
ASSETS_PRIVATE_PATH=.local/dev/assets/private
ASSETS_PRIVATE_URL=/assets/private
ASSET_MAX_SIZE=52428800
ASSET_ALLOWED_EXTENSIONS=jpg|jpeg|png|gif|webp|bmp|svg|mp4|mov|avi|wmv|flv|mkv|mp3|wav|ogg|opus|pdf|doc|docx|ppt|pptx|xls|xlsx|hwp|hwpx|txt|zip

VLLM_EMBEDDING_URL=http://127.0.0.1:8000
VLLM_EMBEDDING_MODEL=BAAI/bge-m3
VLLM_EMBEDDING_TIMEOUT=5
