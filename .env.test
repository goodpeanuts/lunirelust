# Fixed, non-sensitive configuration for disposable integration tests.
APP_ENV=test
COMPOSE_PROJECT_NAME=lunirelust-test

POSTGRES_USER=luna_test
POSTGRES_PASSWORD=luna_test
POSTGRES_DB=luna_test
POSTGRES_PORT=5433
DATABASE_URL=postgres://luna_test:luna_test@127.0.0.1:5433/luna_test
DATABASE_MAX_CONNECTIONS=5
DATABASE_MIN_CONNECTIONS=1

MEILI_MASTER_KEY=luna_test_master_key
MEILI_PORT=7701
MEILI_URL=http://127.0.0.1:7701

SERVICE_HOST=127.0.0.1
SERVICE_PORT=8090
RUST_LOG=debug,sqlx=warn,sea_orm=warn,tower_http=info
JWT_SECRET_KEY=luna-test-only-key

ASSETS_HOME_PATH=.local/test/assets
ASSETS_PUBLIC_PATH=.local/test/assets/public
ASSETS_PUBLIC_URL=/assets/public
ASSETS_PRIVATE_PATH=.local/test/assets/private
ASSETS_PRIVATE_URL=/assets/private
ASSET_MAX_SIZE=52428800
ASSET_ALLOWED_EXTENSIONS=jpg|jpeg|png|gif|webp|bmp|svg|mp4|mov|avi|wmv|flv|mkv|mp3|wav|ogg|opus|pdf|doc|docx|ppt|pptx|xls|xlsx|hwp|hwpx|txt|zip

VLLM_EMBEDDING_URL=http://127.0.0.1:8000
VLLM_EMBEDDING_MODEL=BAAI/bge-m3
VLLM_EMBEDDING_TIMEOUT=5
